# ─────────────────────────────────────────────────────────
# Personal Knowledge Agent — Environment Variables
# ─────────────────────────────────────────────────────────
# Copy this file to `.env` (note the leading dot) and edit:
#   cp env.example .env
# `.env` is git-ignored; never commit secrets.

# ═════════════════════════════════════════════════════════
# Provider selection
# ═════════════════════════════════════════════════════════
# Choose which backends to use for chat completions and
# embeddings. Each can be set independently — e.g. ollama
# for chat (local, free) and openai for embeddings (better
# retrieval quality on small budgets).
# Options: ollama | gemini | openai
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# ═════════════════════════════════════════════════════════
# Ollama (local, no API key required)
# ═════════════════════════════════════════════════════════
# Install:  https://ollama.com/download
# Run:      `ollama serve`  (in a separate terminal)
# Pull:     `ollama pull mistral && ollama pull nomic-embed-text`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=mistral
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ═════════════════════════════════════════════════════════
# Google Gemini (required only if LLM_PROVIDER=gemini)
# ═════════════════════════════════════════════════════════
# Get a free key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_LLM_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/embedding-001

# ═════════════════════════════════════════════════════════
# OpenAI (required only if LLM_PROVIDER=openai)
# ═════════════════════════════════════════════════════════
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ═════════════════════════════════════════════════════════
# Local storage (free, on-disk; Phase 1)
# ═════════════════════════════════════════════════════════
# Chroma persists to SQLite under this directory.
PKA_CHROMA_DIR=./data/chroma_db
# Session/conversation store (SQLite file).
PKA_SQLITE_PATH=./data/sessions.db

# ═════════════════════════════════════════════════════════
# Runtime knobs
# ═════════════════════════════════════════════════════════
# Logging: DEBUG | INFO | WARNING | ERROR
PKA_LOG_LEVEL=INFO
# Soft cap on tokens packed into a single model call.
PKA_MAX_CONTEXT_TOKENS=32000
# How many recent turns to include verbatim in context before
# falling back to summaries (Phase 2 implements summaries).
PKA_HISTORY_TURNS=10
