# ─────────────────────────────────────────────────────────
# Personal Knowledge Agent — Phase 1 Environment Variables
# ─────────────────────────────────────────────────────────
# Copy this file to `.env` (note the leading dot) and fill in
# real values:  `cp env.example .env`
# `.env` is git-ignored; never commit secrets.

# ─── LLM (Google Gemini 2.0 Flash) ────────────────────────
# Get one free at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# CrewAI / LiteLLM picks the model from this string.
# Format: <provider>/<model>. "gemini/gemini-2.0-flash" is the
# Phase 1 default — fast, cheap, 1M-token context.
PKA_LLM_MODEL=gemini/gemini-2.0-flash

# ─── Embeddings (OpenAI text-embedding-3-small) ───────────
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
PKA_EMBEDDING_MODEL=text-embedding-3-small

# ─── Local storage paths (Phase 1: free, on-disk) ─────────
# Chroma persists to SQLite under this directory.
PKA_CHROMA_DIR=./data/chroma_db
# Session/conversation store (SQLite file).
PKA_SQLITE_PATH=./data/sessions.db

# ─── Runtime knobs ────────────────────────────────────────
# Logging: DEBUG | INFO | WARNING | ERROR
PKA_LOG_LEVEL=INFO
# Soft cap on tokens packed into a single Gemini call. Gemini
# 2.0 Flash supports 1M, but we budget conservatively so we
# have headroom for retrieved docs and tool outputs.
PKA_MAX_CONTEXT_TOKENS=32000
# How many recent turns to include verbatim in context before
# falling back to summaries (Phase 2 implements summaries).
PKA_HISTORY_TURNS=10
